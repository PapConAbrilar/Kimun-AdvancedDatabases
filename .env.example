# Copia este archivo como .env y completa los valores del entorno.

# Configuración de Django
DEBUG=False
SECRET_KEY=generate-a-random-secret-key-here-min-50-chars
ALLOWED_HOSTS=kimun.vercel.app,*.vercel.app
CSRF_TRUSTED_ORIGINS=https://kimun.vercel.app

# Persistencia NoSQL en DynamoDB
DYNAMODB_TABLE_NAME=KimunData-Demo
AWS_REGION_PRIMARY=us-east-1
AWS_REGION_SECONDARY=us-west-2

# Almacenamiento de archivos en Supabase Storage
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_KEY=your_anon_key_here
